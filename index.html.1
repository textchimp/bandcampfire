<script type="text/javascript">
function loginWindowWidth(){
    var wwidth = $(window).width();
    if (wwidth < 544) {
        $("#login_window").removeClass("width_500");
        $("#login_window").addClass("width_100p");
        $("#gate_info").removeClass("width_500");
        $("#gate_info").addClass("width_100p");
        $("#input_username_pass").removeClass("width_400");
        $("#input_username_pass").addClass("width_100p");
    }
    else {
        $("#login_window").removeClass("width_100p");
        $("#login_window").addClass("width_500");
        $("#gate_info").removeClass("width_100p");
        $("#gate_info").addClass("width_500");
        $("#input_username_pass").removeClass("width_100p");
        $("#input_username_pass").addClass("width_400");
    }
}

$(document).ready(function() {
    if($.cookie("username") != ""){
        var date = new Date();
        date.setTime(date.getTime() - 1000);
        var Expires = ";expires="+date.toGMTString();
        document.cookie = "username="+""+ Expires + "; path=/";
    }
    // Load menu
    load_sysmenu();
    if ($.browser.msie && ($.browser.version == "6.0") && !$.support.style) {}
    else {
        setInterval("loginWindowWidth()",50);
    }
    utilLoadJavascript("/js/device_info.js", true);
    utilLoadJavascript("/js/wizard.js");
});
</script>
